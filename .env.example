PORT=7071
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
REQUIRE_AUTH=true
MAGNETS=on
BALL_START_SPEED=15.0
BALL_MIN_SPEED=13.0
BALL_HIT_SPEED=18.0
BALL_MAX_SPEED=26.0
BALL_DAMPING=1.0
BALL_HIT_BOOST=1.25
COLLECTIBLE_COUNT=0
MAX_MSG_PER_SEC=120
MAX_CONN_PER_IP=8
CONN_WINDOW_MS=10000
MAX_PAYLOAD=4096
SCORE_TO_WIN=0
ROOM_TIMEOUT_MS=0
FINISHED_RESET_MS=5000
METRICS_INTERVAL_MS=60000
ALLOW_DEBUG=false
# Bots are disabled in server code for PvP-only MVP.
FILL_BOTS=false
BOT_AI=false
BOT_DEADZONE=0.25

# Client (Next.js static export)
# When the WebApp is served over HTTPS (required by Telegram), the WS endpoint must be WSS.
# Examples:
# NEXT_PUBLIC_WS=wss://ws.example.com
# NEXT_PUBLIC_WS=wss://example.com/ws
