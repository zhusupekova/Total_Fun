# Client (Next.js)
# Optional default WS url for /game:
# NEXT_PUBLIC_WS=ws://localhost:7071

# Server (Node WS)
PORT=7071
BOT_TOKEN=your_bot_token_here
REQUIRE_AUTH=true
MAGNETS=on
ALLOW_DEBUG=false
AUTH_GRACE_SEC=86400
MAX_MSG_PER_SEC=120
MAX_CONN_PER_IP=8
CONN_WINDOW_MS=10000
MAX_PAYLOAD=4096
ROOM_TIMEOUT_MS=0
SCORE_TO_WIN=0
FINISHED_RESET_MS=5000
METRICS_INTERVAL_MS=60000
