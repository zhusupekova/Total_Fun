{
  "name": "total_fun-tools",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build",
    "build:assets": "node tools/generate_placeholders.js",
    "smoke:ws": "node tools/ws_smoke.js",
    "smoke:ws:local": "sh -c \"cd server && PORT=7071 node server.js >/tmp/total_fun_ws.log 2>&1 & pid=$!; sleep 2; node ../tools/ws_smoke.js --url=ws://localhost:7071; kill $pid\"",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "format": "prettier --write .",
    "server:start": "node server/server.js",
    "test:all": "npm run lint && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35"
  }
}
